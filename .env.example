# Copy to .env.local and fill in. Never commit real values.
# Every variable here is server-only. Nothing in this app needs a NEXT_PUBLIC_ key.

# Supabase shared "lab" project, schema `agendo`
SUPABASE_URL=
# sb_secret_… Bypasses RLS, so it is used only from server code in src/lib/db.
SUPABASE_SECRET_KEY=

# Phone handling. Generate each with: openssl rand -base64 32
# Changing the pepper orphans every stored phone_hash; changing the key makes every
# stored phone_encrypted unreadable.
PHONE_HASH_PEPPER=
PHONE_ENCRYPTION_KEY=

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Sandbox sender, for example whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
# The exact public URL set in the Sandbox settings. Signatures are checked against it.
TWILIO_WEBHOOK_URL=

# Linked from the consent message. The real page is T25.
PRIVACY_POLICY_URL=

# Read by @ai-sdk/openai. Not used until the agent exists (Phase 2).
OPENAI_API_KEY=

# Web chat demo. Off unless set to 1: it has no rate limit or daily cap until T16 and T17.
DEMO_CHAT_ENABLED=
# The receiving_number of the synthetic tenant the demo talks to.
DEMO_RECEIVING_NUMBER=

# Upstash Redis (rate limits; the FAQ response cache in T18). Without these, `next dev`
# runs with rate limits off and `next start` refuses to serve the agent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
